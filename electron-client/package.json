{
  "name": "fedapp-client",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5174 && electron .\"",
    "build:react": "vite build",
    "build:electron": "electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "build": "npm run build:react && npm run build:electron"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "axios": "^1.13.4", 
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^5.4.11",
    "wait-on": "^9.0.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.kaif.fedapp",
    "productName": "FedAppClient",
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": "portable"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "electron/**/*",
      "python/**/*"
    ]
  }
}